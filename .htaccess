# Optional Apache settings for InfinityFree (safe to keep or delete).
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs
AddType application/json .json
AddType image/svg+xml .svg
AddType font/woff2 .woff2

Options -Indexes

# Never serve dev-only files if they were uploaded by mistake
<FilesMatch "\.(md|mjs|sh|log)$|^package\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  <FilesMatch "\.(css|js|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|json|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
